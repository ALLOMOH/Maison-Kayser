---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MynaIcon from "@/components/MynaIcon.astro";

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? "2250700333444";
---

<BaseLayout
  title="Page introuvable - Maison Kayser Abidjan"
  description="Cette page Maison Kayser Abidjan est introuvable. Retrouvez la carte, les pâtisseries, les viennoiseries et les commandes WhatsApp."
>
  <main class="relative min-h-screen overflow-hidden bg-espresso text-cream">
    <img
      src="/hero.jpg"
      alt=""
      class="absolute inset-0 size-full object-cover opacity-35"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-espresso/60 via-espresso/80 to-espresso"></div>

    <section class="container-premium relative flex min-h-screen items-center py-20">
      <div class="max-w-3xl">
        <a href="/" class="font-display text-3xl tracking-[.08em] text-saffron">Maison Kayser</a>
        <p class="eyebrow mt-12 text-saffron">Erreur 404</p>
        <h1 class="display-title mt-5 text-6xl sm:text-7xl lg:text-8xl">
          Cette page n'est plus au menu.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-cream/72">
          Le lien demandé est introuvable, mais la vitrine, les pains, les pâtisseries et le panier WhatsApp vous attendent toujours.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/" class="premium-button bg-caramel text-linen shadow-soft hover:bg-saffron">
            Retour à l'accueil
            <MynaIcon name="arrow" />
          </a>
          <a href="/#carte" class="premium-button border border-cream/25 text-cream hover:border-saffron hover:text-saffron">
            Voir la carte
          </a>
          <a href={`https://wa.me/${whatsappNumber}`} class="premium-button border border-whatsapp/60 text-whatsapp hover:bg-whatsapp hover:text-white">
            <MynaIcon name="whatsapp" />
            WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
